<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             Title="HospedagemContratada"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <VerticalStackLayout VerticalOptions="CenterAndExpand"
                         Padding="10"
                         Spacing="10">

        <Label Text="Hospedagem Contratada"
               FontFamily="Kalam"
               FontSize="40"
               TextColor="{StaticResource Primary}" />

        <Frame Padding="20">
            <VerticalStackLayout Spacing="8">
                <Label Text="{Binding QuartoSelecionado.Descricao, StringFormat='Suíte: {0}'}" />
                <Label Text="{Binding Adultos, StringFormat='Adultos: {0}'}" />
                <Label Text="{Binding Criancas, StringFormat='Crianças: {0}'}" />
                <Label Text="{Binding DataCheckIn, StringFormat='Check-in: {0:dd/MM/yyyy}'}" />
                <Label Text="{Binding DataCheckOut, StringFormat='Check-out: {0:dd/MM/yyyy}'}" />
                <Label Text="{Binding Estadia, StringFormat='Estadia: {0} dia(s)'}" />
                <Label Text="{Binding ValorTotal, StringFormat='Valor total: {0:C}'}"
                       FontSize="Subtitle"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}" />

                <Button Text="Voltar" Clicked="Button_Clicked" />
            </VerticalStackLayout>
        </Frame>
    </VerticalStackLayout>

</ContentPage>