<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.Sobre"
             Title="Sobre"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <ScrollView>
        <VerticalStackLayout VerticalOptions="CenterAndExpand"
                             Padding="10"
                             Spacing="10">

            <Label Text="Sobre"
                   FontFamily="Kalam"
                   FontSize="50"
                   TextColor="{StaticResource Primary}" />

            <Frame Padding="20">
                <VerticalStackLayout Spacing="8">

                    <Label Text="App Hotel"
                           FontFamily="Kalam"
                           FontSize="30"
                           TextColor="{StaticResource Primary}" />

                    <Label Text="Desenvolvedor"
                           TextTransform="Uppercase"
                           FontSize="Subtitle"
                           TextColor="{StaticResource Primary}" />
                    <Label Text="Gabriel Ferreira Garcia de Carvalho" />

                    <Label Text="Ano de desenvolvimento"
                           TextTransform="Uppercase"
                           FontSize="Subtitle"
                           TextColor="{StaticResource Primary}" />
                    <Label Text="2026" />

                    <Label Text="Curso"
                           TextTransform="Uppercase"
                           FontSize="Subtitle"
                           TextColor="{StaticResource Primary}" />
                    <Label Text="Técnico em Desenvolvimento de Sistemas - ETEC" />

                    <Label Text="Componente"
                           TextTransform="Uppercase"
                           FontSize="Subtitle"
                           TextColor="{StaticResource Primary}" />
                    <Label Text="Programação Mobile I - Agenda 13" />

                    <Button Text="Voltar" Clicked="Button_Clicked" />
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>